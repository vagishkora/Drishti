# Drishti Backend Environment Template
# Duplicate this file as .env and fill in your actual credentials.

PORT=3001
FRONTEND_URL=http://localhost:5173

# Neon Serverless PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@ep-your-subdomain.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cryptographic Master Key & JWT Secret (32+ character high-entropy string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_2026!
ENCRYPTION_KEY=replace_with_a_secure_aes256_master_key_or_leave_empty

# Razorpay Sandbox Credentials (Optional for payment gateway testing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
